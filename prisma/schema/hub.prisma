model Hub {
    id                   String     @id @default(uuid())
    name                 String
    location             String
    zoneId               String
    zone                 Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    status               HubStatus  @default(ACTIVE)
    isInDhaka            Boolean    @default(true)
    createdAt            DateTime   @default(now())
    updatedAt            DateTime   @updatedAt
    originShipments      Shipment[] @relation("OriginHub")
    destinationShipments Shipment[] @relation("DestinationHub")

    @@map("hubs")
}
