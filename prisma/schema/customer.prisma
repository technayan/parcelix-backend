model Customer {
    id        String     @id @default(uuid())
    userId    String     @unique
    user      User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    address   String?
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
    shipments Shipment[]

    @@map("customers")
}
