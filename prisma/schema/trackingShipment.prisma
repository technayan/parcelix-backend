model TrackingShipment {
    id         String                 @id @default(uuid())
    shipmentId String
    shipment   Shipment               @relation(fields: [shipmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    status     TrackingShipmentStatus @default(PAID)
    createdAt  DateTime               @default(now())

    @@index([shipmentId, createdAt])
    @@map("trackingShipments")
}
