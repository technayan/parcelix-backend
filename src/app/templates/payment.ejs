<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Successful - Parcelix</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f8fafc;
        font-family: Inter, Arial, Helvetica, sans-serif;
        color: #0f172a;
      }

      .wrapper {
        width: 100%;
        padding: 40px 15px;
        box-sizing: border-box;
      }

      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
      }

      /* Header */
      .header {
        background-color: #0f172a;
        padding: 28px 40px;
        text-align: center;
      }

      .logo {
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -1px;
        color: #ffffff;
      }

      .logo span {
        color: #f97316;
      }

      .tagline {
        margin-top: 6px;
        color: #94a3b8;
        font-size: 13px;
      }

      /* Content */
      .content {
        padding: 45px 40px;
      }

      .success-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 25px;
        background-color: #ecfdf5;
        border-radius: 50%;
        text-align: center;
        line-height: 64px;
        font-size: 30px;
        color: #10b981;
        font-weight: 700;
      }

      .title {
        margin: 0;
        text-align: center;
        color: #0f172a;
        font-size: 27px;
        line-height: 1.3;
        font-weight: 700;
      }

      .subtitle {
        margin: 10px 0 30px;
        text-align: center;
        color: #64748b;
        font-size: 15px;
        line-height: 1.6;
      }

      .greeting {
        color: #334155;
        font-size: 15px;
        line-height: 1.7;
      }

      .message {
        color: #64748b;
        font-size: 14px;
        line-height: 1.7;
      }

      /* Payment Box */
      .payment-box {
        margin: 28px 0;
        padding: 22px;
        background-color: #ecfdf5;
        border: 1px solid #a7f3d0;
        border-radius: 12px;
      }

      .payment-title {
        margin: 0 0 8px;
        color: #047857;
        font-size: 16px;
        font-weight: 700;
      }

      .payment-text {
        margin: 0;
        color: #065f46;
        font-size: 13px;
        line-height: 1.6;
      }

      /* Invoice Box */
      .invoice-box {
        margin: 25px 0;
        padding: 22px;
        background-color: #fff7ed;
        border: 1px solid #fed7aa;
        border-radius: 12px;
      }

      .invoice-title {
        margin: 0 0 8px;
        color: #c2410c;
        font-size: 16px;
        font-weight: 700;
      }

      .invoice-text {
        margin: 0;
        color: #9a3412;
        font-size: 13px;
        line-height: 1.6;
      }

      .invoice-number {
        margin-top: 12px;
        padding: 10px 14px;
        background-color: #ffffff;
        border: 1px solid #fed7aa;
        border-radius: 8px;
        color: #0f172a;
        font-size: 13px;
        font-weight: 600;
      }

      /* Shipment Details */
      .details {
        margin: 28px 0;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
      }

      .details-header {
        padding: 12px 16px;
        background-color: #f8fafc;
        color: #0f172a;
        font-size: 14px;
        font-weight: 700;
      }

      .details-row {
        padding: 11px 16px;
        border-top: 1px solid #e2e8f0;
        font-size: 13px;
      }

      .details-label {
        color: #64748b;
      }

      .details-value {
        color: #0f172a;
        font-weight: 600;
      }

      /* Closing */
      .closing {
        margin-top: 28px;
        color: #334155;
        font-size: 14px;
        line-height: 1.7;
      }

      /* Footer */
      .footer {
        padding: 25px 40px;
        background-color: #f8fafc;
        border-top: 1px solid #e2e8f0;
        text-align: center;
      }

      .footer-text {
        margin: 0;
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.6;
      }

      .footer-brand {
        margin-top: 8px;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 10px;
        }

        .header,
        .content,
        .footer {
          padding-left: 25px;
          padding-right: 25px;
        }

        .title {
          font-size: 24px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">
        <!-- Header -->
        <div class="header">
          <div class="logo">Parcel<span>ix</span></div>
        </div>

        <!-- Content -->
        <div class="content">
          <!-- Success Icon -->
          <div class="success-icon">✓</div>

          <h1 class="title">Payment Successful!</h1>

          <p class="subtitle">
            Thank you for choosing Parcelix for your shipment.
          </p>

          <p class="greeting">Hi <strong><%= name %></strong>,</p>

          <p class="message">
            Thank you for using Parcelix. We truly appreciate your trust and
            choosing us to deliver your shipment safely and reliably.
          </p>

          <!-- Payment Success -->
          <div class="payment-box">
            <p class="payment-title">✓ Your payment has been received</p>

            <p class="payment-text">
              Your shipment payment was successfully completed. Your shipment is
              now ready to proceed through the Parcelix delivery process.
            </p>
          </div>

          <!-- Shipment Details -->
          <div class="details">
            <div class="details-header">Shipment Information</div>

            <div class="details-row">
              <span class="details-label">Tracking ID:</span>
              <span class="details-value"><%= trackingId %></span>
            </div>

            <div class="details-row">
              <span class="details-label">Invoice Number:</span>
              <span class="details-value"><%= invoiceNumber %></span>
            </div>

            <div class="details-row">
              <span class="details-label">Amount Paid:</span>
              <span class="details-value">BDT <%= amount %></span>
            </div>

            <div class="details-row">
              <span class="details-label">Payment Method:</span>
              <span class="details-value"><%= paymentGateway %></span>
            </div>
          </div>

          <!-- Invoice -->
          <div class="invoice-box">
            <p class="invoice-title">📄 Your Invoice is Attached</p>

            <p class="invoice-text">
              We have attached your payment invoice to this email. Please keep
              the invoice for your records and future reference.
            </p>
          </div>

          <p class="closing">
            You can use your tracking ID to follow your shipment's progress. We
            will keep you updated as your parcel moves through each stage of the
            delivery process.
          </p>

          <p class="closing">
            Thank you again for choosing <strong>Parcelix</strong>. We look
            forward to serving you again!
          </p>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p class="footer-text">
            If you have any questions about your shipment or payment, please
            contact Parcelix support.
          </p>

          <p class="footer-brand">
            © <%= new Date().getFullYear() %> Parcelix. All rights reserved.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
