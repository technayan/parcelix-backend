<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Shipment Returned - Parcelix</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f8fafc;
        font-family: Inter, Arial, Helvetica, sans-serif;
        color: #0f172a;
      }

      .wrapper {
        width: 100%;
        padding: 40px 15px;
        box-sizing: border-box;
      }

      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
      }

      /* Header */

      .header {
        background-color: #0f172a;
        padding: 28px 40px;
        text-align: center;
      }

      .logo {
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -1px;
        color: #ffffff;
      }

      .logo span {
        color: #f97316;
      }

      .tagline {
        margin-top: 6px;
        color: #94a3b8;
        font-size: 13px;
      }

      /* Content */

      .content {
        padding: 45px 40px;
      }

      .return-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 25px;
        background-color: #fef2f2;
        border-radius: 50%;
        text-align: center;
        line-height: 64px;
        font-size: 30px;
        color: #ef4444;
        font-weight: 700;
      }

      .title {
        margin: 0;
        text-align: center;
        color: #0f172a;
        font-size: 27px;
        line-height: 1.3;
        font-weight: 700;
      }

      .subtitle {
        margin: 10px 0 30px;
        text-align: center;
        color: #64748b;
        font-size: 15px;
        line-height: 1.6;
      }

      .greeting {
        color: #334155;
        font-size: 15px;
        line-height: 1.7;
      }

      .message {
        color: #64748b;
        font-size: 14px;
        line-height: 1.7;
      }

      /* Return Box */

      .return-box {
        margin: 28px 0;
        padding: 22px;
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 12px;
      }

      .return-title {
        margin: 0 0 8px;
        color: #b91c1c;
        font-size: 16px;
        font-weight: 700;
      }

      .return-text {
        margin: 0;
        color: #991b1b;
        font-size: 13px;
        line-height: 1.6;
      }

      /* Return Reason */

      .reason-box {
        margin: 25px 0;
        padding: 22px;
        background-color: #fff7ed;
        border: 1px solid #fed7aa;
        border-radius: 12px;
      }

      .reason-title {
        margin: 0 0 8px;
        color: #c2410c;
        font-size: 16px;
        font-weight: 700;
      }

      .reason-text {
        margin: 0;
        color: #9a3412;
        font-size: 13px;
        line-height: 1.7;
      }

      /* Shipment Details */

      .details {
        margin: 28px 0;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
      }

      .details-header {
        padding: 12px 16px;
        background-color: #f8fafc;
        color: #0f172a;
        font-size: 14px;
        font-weight: 700;
      }

      .details-row {
        padding: 11px 16px;
        border-top: 1px solid #e2e8f0;
        font-size: 13px;
      }

      .details-label {
        color: #64748b;
      }

      .details-value {
        color: #0f172a;
        font-weight: 600;
      }

      .status-returned {
        color: #dc2626;
        font-weight: 700;
      }

      /* Closing */

      .closing {
        margin-top: 28px;
        color: #334155;
        font-size: 14px;
        line-height: 1.7;
      }

      /* Footer */

      .footer {
        padding: 25px 40px;
        background-color: #f8fafc;
        border-top: 1px solid #e2e8f0;
        text-align: center;
      }

      .footer-text {
        margin: 0;
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.6;
      }

      .footer-brand {
        margin-top: 8px;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 10px;
        }

        .header,
        .content,
        .footer {
          padding-left: 25px;
          padding-right: 25px;
        }

        .title {
          font-size: 24px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">
        <!-- Header -->

        <div class="header">
          <div class="logo">Parcel<span>ix</span></div>
        </div>

        <!-- Content -->

        <div class="content">
          <!-- Return Icon -->

          <div class="return-icon">↩</div>

          <h1 class="title">Shipment Returned</h1>

          <p class="subtitle">
            Your shipment could not be delivered and has been returned.
          </p>

          <p class="greeting">Hi <strong><%= name %></strong>,</p>

          <p class="message">
            We are writing to let you know that your shipment could not be
            successfully delivered to the receiver. As a result, the parcel has
            been marked as returned.
          </p>

          <!-- Return Status -->

          <div class="return-box">
            <p class="return-title">↩ Shipment Returned</p>

            <p class="return-text">
              Your shipment has been returned and the delivery process for this
              shipment has now been completed.
            </p>
          </div>

          <!-- Return Reason -->

          <div class="reason-box">
            <p class="reason-title">Return Reason</p>

            <% if (returnReason) { %>
            <p class="reason-text"><%= returnReason %></p>
            <% } %>
          </div>

          <!-- Shipment Details -->

          <div class="details">
            <div class="details-header">Shipment Information</div>

            <div class="details-row">
              <span class="details-label"> Tracking ID: </span>

              <span class="details-value"> <%= trackingId %> </span>
            </div>

            <div class="details-row">
              <span class="details-label"> Receiver: </span>

              <span class="details-value"> <%= receiverName %> </span>
            </div>

            <div class="details-row">
              <span class="details-label"> Return Date: </span>

              <% if (returnedAt) { %>
              <span class="details-value"> <%= returnedAt %> </span>
              <% } %>
            </div>

            <div class="details-row">
              <span class="details-label"> Status: </span>

              <span class="status-returned"> RETURNED </span>
            </div>
          </div>

          <p class="closing">
            If you have any questions regarding the return of your shipment,
            please contact Parcelix support with your tracking ID.
          </p>

          <p class="closing">
            Thank you for choosing <strong>Parcelix</strong>. We appreciate your
            trust and hope to serve you again.
          </p>
        </div>

        <!-- Footer -->

        <div class="footer">
          <p class="footer-text">
            If you have any questions about your returned shipment, please
            contact Parcelix support.
          </p>

          <p class="footer-brand">
            © <%= new Date().getFullYear() %> Parcelix. All rights reserved.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
