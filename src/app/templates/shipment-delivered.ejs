<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Shipment Delivered - Parcelix</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f8fafc;
        font-family: Inter, Arial, Helvetica, sans-serif;
        color: #0f172a;
      }

      .wrapper {
        width: 100%;
        padding: 40px 15px;
        box-sizing: border-box;
      }

      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
      }

      /* Header */

      .header {
        background-color: #0f172a;
        padding: 28px 40px;
        text-align: center;
      }

      .logo {
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -1px;
        color: #ffffff;
      }

      .logo span {
        color: #f97316;
      }

      .tagline {
        margin-top: 6px;
        color: #94a3b8;
        font-size: 13px;
      }

      /* Content */

      .content {
        padding: 45px 40px;
      }

      .success-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 25px;
        background-color: #ecfdf5;
        border-radius: 50%;
        text-align: center;
        line-height: 64px;
        font-size: 30px;
        color: #10b981;
        font-weight: 700;
      }

      .title {
        margin: 0;
        text-align: center;
        color: #0f172a;
        font-size: 27px;
        line-height: 1.3;
        font-weight: 700;
      }

      .subtitle {
        margin: 10px 0 30px;
        text-align: center;
        color: #64748b;
        font-size: 15px;
        line-height: 1.6;
      }

      .greeting {
        color: #334155;
        font-size: 15px;
        line-height: 1.7;
      }

      .message {
        color: #64748b;
        font-size: 14px;
        line-height: 1.7;
      }

      /* Delivery Box */

      .delivery-box {
        margin: 28px 0;
        padding: 22px;
        background-color: #ecfdf5;
        border: 1px solid #a7f3d0;
        border-radius: 12px;
      }

      .delivery-title {
        margin: 0 0 8px;
        color: #047857;
        font-size: 16px;
        font-weight: 700;
      }

      .delivery-text {
        margin: 0;
        color: #065f46;
        font-size: 13px;
        line-height: 1.6;
      }

      /* Shipment Details */

      .details {
        margin: 28px 0;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
      }

      .details-header {
        padding: 12px 16px;
        background-color: #f8fafc;
        color: #0f172a;
        font-size: 14px;
        font-weight: 700;
      }

      .details-row {
        padding: 11px 16px;
        border-top: 1px solid #e2e8f0;
        font-size: 13px;
      }

      .details-label {
        color: #64748b;
      }

      .details-value {
        color: #0f172a;
        font-weight: 600;
      }

      .status-delivered {
        color: #059669;
        font-weight: 700;
      }

      /* Closing */

      .closing {
        margin-top: 28px;
        color: #334155;
        font-size: 14px;
        line-height: 1.7;
      }

      /* Footer */

      .footer {
        padding: 25px 40px;
        background-color: #f8fafc;
        border-top: 1px solid #e2e8f0;
        text-align: center;
      }

      .footer-text {
        margin: 0;
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.6;
      }

      .footer-brand {
        margin-top: 8px;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 10px;
        }

        .header,
        .content,
        .footer {
          padding-left: 25px;
          padding-right: 25px;
        }

        .title {
          font-size: 24px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">
        <!-- Header -->

        <div class="header">
          <div class="logo">Parcel<span>ix</span></div>
        </div>

        <!-- Content -->

        <div class="content">
          <!-- Success Icon -->

          <div class="success-icon">✓</div>

          <h1 class="title">Shipment Delivered!</h1>

          <p class="subtitle">Your parcel has been successfully delivered.</p>

          <p class="greeting">Hi <strong><%= name %></strong>,</p>

          <p class="message">
            We're happy to let you know that your shipment has been successfully
            delivered to the receiver. Thank you for trusting Parcelix with your
            delivery.
          </p>

          <!-- Delivery Status -->

          <div class="delivery-box">
            <p class="delivery-title">✓ Delivery Completed</p>

            <p class="delivery-text">
              Your shipment has successfully reached its destination and the
              delivery process is now complete.
            </p>
          </div>

          <!-- Shipment Details -->

          <div class="details">
            <div class="details-header">Shipment Information</div>

            <div class="details-row">
              <span class="details-label"> Tracking ID: </span>

              <span class="details-value"> <%= trackingId %> </span>
            </div>

            <div class="details-row">
              <span class="details-label"> Receiver: </span>

              <span class="details-value"> <%= receiverName %> </span>
            </div>

            <div class="details-row">
              <span class="details-label"> Delivered At: </span>

              <% if (deliveredAt) { %>
              <span class="details-value"> <%= deliveredAt %> </span>
              <% } %>
            </div>

            <div class="details-row">
              <span class="details-label"> Status: </span>

              <span class="status-delivered"> DELIVERED </span>
            </div>
          </div>

          <p class="closing">
            You can keep your tracking ID for your records. Your shipment
            delivery has now been completed successfully.
          </p>

          <p class="closing">
            Thank you again for choosing <strong>Parcelix</strong>. We look
            forward to serving you again!
          </p>
        </div>

        <!-- Footer -->

        <div class="footer">
          <p class="footer-text">
            If you have any questions about your completed shipment, please
            contact Parcelix support.
          </p>

          <p class="footer-brand">
            © <%= new Date().getFullYear() %> Parcelix. All rights reserved.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
