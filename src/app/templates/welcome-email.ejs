<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>Welcome to Parcelix</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f8fafc;
        font-family: Arial, Helvetica, sans-serif;
        color: #0f172a;
      }

      table {
        border-spacing: 0;
        border-collapse: collapse;
      }

      img {
        border: 0;
        display: block;
      }

      .email-wrapper {
        width: 100%;
        background-color: #f8fafc;
        padding: 40px 16px;
      }

      .email-container {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
      }

      .header {
        background-color: #0f172a;
        padding: 28px 24px;
        text-align: center;
      }

      .logo {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.5px;
        color: #ffffff !important;
      }

      .logo span {
        color: #f97316;
      }

      .content {
        padding: 40px 36px;
      }

      .welcome-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 24px;
        background-color: #fff7ed;
        border-radius: 50%;
        text-align: center;
        font-size: 30px;
        line-height: 64px;
      }

      .welcome-icon img {
        padding-top: 15px;
        padding-left: 13px;
      }

      .title {
        margin: 0 0 16px;
        text-align: center;
        font-size: 26px;
        line-height: 1.3;
        font-weight: 700;
        color: #0f172a;
      }

      .greeting {
        margin: 0 0 18px;
        font-size: 16px;
        line-height: 1.7;
        color: #334155;
      }

      .message {
        margin: 0 0 24px;
        font-size: 15px;
        line-height: 1.7;
        color: #64748b;
      }

      .highlight-box {
        margin: 28px 0;
        padding: 20px;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-left: 4px solid #f97316;
        border-radius: 8px;
      }

      .highlight-title {
        margin: 0 0 8px;
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
      }

      .highlight-text {
        margin: 0;
        font-size: 14px;
        line-height: 1.6;
        color: #64748b;
      }

      .button-wrapper {
        text-align: center;
        margin: 30px 0;
      }

      .button {
        display: inline-block;
        padding: 13px 28px;
        background-color: #f97316;
        color: #ffffff !important;
        text-decoration: none;
        font-size: 15px;
        font-weight: 700;
        border-radius: 8px;
      }

      .button:hover {
        background-color: #ea580c;
      }

      .closing {
        margin: 28px 0 0;
        font-size: 15px;
        line-height: 1.7;
        color: #334155;
      }

      .footer {
        padding: 24px;
        background-color: #f8fafc;
        border-top: 1px solid #e2e8f0;
        text-align: center;
      }

      .footer-text {
        margin: 0 0 8px;
        font-size: 12px;
        line-height: 1.6;
        color: #94a3b8;
      }

      .footer-brand {
        margin: 0;
        font-size: 13px;
        font-weight: 700;
        color: #334155;
      }

      .footer-brand span {
        color: #f97316;
      }

      @media only screen and (max-width: 600px) {
        .email-wrapper {
          padding: 20px 10px;
        }

        .content {
          padding: 32px 22px;
        }

        .title {
          font-size: 23px;
        }

        .logo {
          font-size: 27px;
        }
      }
    </style>
  </head>

  <body>
    <table role="presentation" width="100%">
      <tr>
        <td class="email-wrapper">
          <table
            role="presentation"
            class="email-container"
            align="center"
            width="100%"
          >
            <!-- Header -->
            <tr>
              <td class="header">
                <h1 class="logo">Parcel<span>ix</span></h1>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td class="content">
                <div class="welcome-icon">👋</div>

                <h2 class="title">Welcome to Parcelix!</h2>

                <p class="greeting">Hello <strong><%= name %></strong>,</p>

                <p class="message">
                  We're excited to have you with us! Your Parcelix account has
                  been successfully created. You can login to your account and
                  you're now ready to experience a simpler and more reliable way
                  to manage your shipments.
                </p>

                <div class="highlight-box">
                  <p class="highlight-title">Your account is ready 🚀</p>

                  <p class="highlight-text">
                    From creating shipments to tracking deliveries, Parcelix
                    gives you the tools you need to keep your parcels moving
                    smoothly.
                  </p>
                </div>

                <div class="button-wrapper">
                  <a
                    href="<%= url %>"
                    class="button"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Go to Parcelix
                  </a>
                </div>

                <p class="closing">
                  Thank you for choosing Parcelix. We look forward to being a
                  part of your delivery journey.
                </p>

                <p class="closing">
                  Best regards,<br />
                  <strong>The Parcelix Team</strong>
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td class="footer">
                <p class="footer-text">
                  You're receiving this email because an account was created
                  using this email address.
                </p>

                <p class="footer-brand">
                  © <%= new Date().getFullYear() %> Parcel<span>ix</span>. All
                  rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
