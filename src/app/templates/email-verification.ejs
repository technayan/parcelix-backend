<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>Verify Your Parcelix Account</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f8fafc;
        font-family: Inter, Arial, Helvetica, sans-serif;
        color: #0f172a;
      }

      table {
        border-spacing: 0;
        border-collapse: collapse;
      }

      .email-wrapper {
        width: 100%;
        padding: 40px 16px;
        background-color: #f8fafc;
      }

      .email-container {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
      }

      /* Header */
      .header {
        background-color: #0f172a;
        padding: 28px 40px;
        text-align: center;
      }

      .logo {
        color: #ffffff !important;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.8px;
        text-decoration: none;
      }

      .logo-accent {
        color: #f97316;
      }

      /* Content */
      .content {
        padding: 45px 40px;
      }

      .icon-wrapper {
        width: 64px;
        height: 64px;
        margin: 0 auto 24px;
        background-color: #fff7ed;
        border-radius: 50%;
        text-align: center;
      }

      .icon {
        font-size: 28px;
        line-height: 64px;
      }

      .title {
        margin: 0 0 16px;
        color: #0f172a;
        font-size: 28px;
        line-height: 1.3;
        font-weight: 700;
        text-align: center;
      }

      .greeting {
        margin: 0 0 14px;
        color: #334155;
        font-size: 16px;
        line-height: 1.7;
      }

      .message {
        margin: 0 0 28px;
        color: #64748b;
        font-size: 15px;
        line-height: 1.7;
      }

      /* OTP */
      .otp-container {
        margin: 30px 0;
        padding: 24px;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        text-align: center;
      }

      .otp-label {
        margin: 0 0 10px;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.8px;
        text-transform: uppercase;
      }

      .otp {
        margin: 0;
        color: #f97316;
        font-size: 36px;
        line-height: 1.2;
        font-weight: 700;
        letter-spacing: 8px;
      }

      .expiry {
        margin: 18px 0 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.5;
      }

      .expiry strong {
        color: #0f172a;
      }

      /* Security Notice */
      .security-box {
        margin-top: 30px;
        padding: 16px 18px;
        background-color: #fff7ed;
        border-left: 4px solid #f97316;
        border-radius: 6px;
      }

      .security-title {
        margin: 0 0 5px;
        color: #0f172a;
        font-size: 13px;
        font-weight: 700;
      }

      .security-text {
        margin: 0;
        color: #64748b;
        font-size: 12px;
        line-height: 1.6;
      }

      /* Footer */
      .footer {
        padding: 25px 40px;
        background-color: #f8fafc;
        border-top: 1px solid #e2e8f0;
        text-align: center;
      }

      .footer-text {
        margin: 0 0 8px;
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.6;
      }

      .copyright {
        margin: 0;
        color: #94a3b8;
        font-size: 12px;
      }

      /* Mobile */
      @media only screen and (max-width: 600px) {
        .email-wrapper {
          padding: 20px 10px;
        }

        .header {
          padding: 24px 20px;
        }

        .content {
          padding: 35px 24px;
        }

        .footer {
          padding: 22px 24px;
        }

        .title {
          font-size: 24px;
        }

        .otp {
          font-size: 30px;
          letter-spacing: 6px;
        }
      }
    </style>
  </head>

  <body>
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      class="email-wrapper"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            class="email-container"
          >
            <!-- Header -->
            <tr>
              <td class="header">
                <a href="#" class="logo">
                  Parcel<span class="logo-accent">ix</span>
                </a>
              </td>
            </tr>

            <!-- Main Content -->
            <tr>
              <td class="content">
                <!-- Icon -->
                <div class="icon-wrapper">
                  <span class="icon">✉️</span>
                </div>

                <!-- Title -->
                <h1 class="title">Verify Your Email</h1>

                <!-- Greeting -->
                <p class="greeting">Hi <strong><%= name %></strong>,</p>

                <!-- Message -->
                <p class="message">
                  Welcome to Parcelix! To complete your registration and secure
                  your account, please enter the verification code below.
                </p>

                <!-- OTP -->
                <div class="otp-container">
                  <p class="otp-label">Your verification code</p>

                  <p class="otp"><%= otp %></p>

                  <p class="expiry">
                    This code will expire in
                    <strong><%= expirationMinutes %> minutes</strong>.
                  </p>
                </div>

                <!-- Security Notice -->
                <div class="security-box">
                  <p class="security-title">🔒 Keep your code secure</p>

                  <p class="security-text">
                    Never share this verification code with anyone. Parcelix
                    will never ask you for your OTP by phone, email, or message.
                  </p>
                </div>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td class="footer">
                <p class="footer-text">
                  If you didn't create a Parcelix account, you can safely ignore
                  this email.
                </p>

                <p class="copyright">
                  © <%= new Date().getFullYear() %> Parcelix. All rights
                  reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
