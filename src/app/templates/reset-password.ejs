<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>Password Reset Successful - Parcelix</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f8fafc;
        font-family: Inter, Arial, Helvetica, sans-serif;
        color: #0f172a;
      }

      table {
        border-spacing: 0;
        border-collapse: collapse;
      }

      .email-wrapper {
        width: 100%;
        padding: 40px 16px;
        background-color: #f8fafc;
      }

      .email-container {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
      }

      /* Header */

      .header {
        background-color: #0f172a;
        padding: 28px 40px;
        text-align: center;
      }

      .logo {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.5px;
        color: #ffffff !important;
      }

      .logo span {
        color: #f97316;
      }

      /* Content */

      .content {
        padding: 45px 40px;
      }

      .icon-wrapper {
        width: 64px;
        height: 64px;
        margin: 0 auto 24px;
        background-color: #ecfdf5;
        border-radius: 50%;
        text-align: center;
      }

      .icon {
        font-size: 28px;
        line-height: 64px;
      }

      .title {
        margin: 0 0 16px;
        color: #0f172a;
        font-size: 28px;
        line-height: 1.3;
        font-weight: 700;
        text-align: center;
      }

      .greeting {
        margin: 0 0 14px;
        color: #334155;
        font-size: 16px;
        line-height: 1.7;
      }

      .message {
        margin: 0 0 28px;
        color: #64748b;
        font-size: 15px;
        line-height: 1.7;
      }

      /* Success Box */

      .success-box {
        margin: 30px 0;
        padding: 22px;
        background-color: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-left: 4px solid #10b981;
        border-radius: 8px;
      }

      .success-title {
        margin: 0 0 8px;
        color: #166534;
        font-size: 15px;
        font-weight: 700;
      }

      .success-text {
        margin: 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.6;
      }

      /* Button */

      .button-wrapper {
        margin: 30px 0;
        text-align: center;
      }

      .button {
        display: inline-block;
        padding: 13px 28px;
        background-color: #f97316;
        color: #ffffff !important;
        text-decoration: none;
        font-size: 15px;
        font-weight: 700;
        border-radius: 8px;
      }

      .button:hover {
        background-color: #ea580c;
      }

      /* Security Notice */

      .security-box {
        margin-top: 30px;
        padding: 16px 18px;
        background-color: #fff7ed;
        border-left: 4px solid #f97316;
        border-radius: 6px;
      }

      .security-title {
        margin: 0 0 5px;
        color: #0f172a;
        font-size: 13px;
        font-weight: 700;
      }

      .security-text {
        margin: 0;
        color: #64748b;
        font-size: 12px;
        line-height: 1.6;
      }

      /* Closing */

      .closing {
        margin: 28px 0 0;
        color: #334155;
        font-size: 15px;
        line-height: 1.7;
      }

      /* Footer */

      .footer {
        padding: 25px 40px;
        background-color: #f8fafc;
        border-top: 1px solid #e2e8f0;
        text-align: center;
      }

      .footer-text {
        margin: 0 0 8px;
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.6;
      }

      .copyright {
        margin: 0;
        color: #94a3b8;
        font-size: 12px;
      }

      /* Mobile */

      @media only screen and (max-width: 600px) {
        .email-wrapper {
          padding: 20px 10px;
        }

        .header {
          padding: 24px 20px;
        }

        .content {
          padding: 35px 24px;
        }

        .footer {
          padding: 22px 24px;
        }

        .title {
          font-size: 24px;
        }
      }
    </style>
  </head>

  <body>
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      class="email-wrapper"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            class="email-container"
          >
            <!-- Header -->

            <tr>
              <td class="header">
                <h1 class="logo">Parcel<span>ix</span></h1>
              </td>
            </tr>

            <!-- Main Content -->

            <tr>
              <td class="content">
                <!-- Success Icon -->

                <div class="icon-wrapper">
                  <span class="icon">✓</span>
                </div>

                <!-- Title -->

                <h1 class="title">Password Reset Successful</h1>

                <!-- Greeting -->

                <p class="greeting">Hi <strong><%= name %></strong>,</p>

                <!-- Message -->

                <p class="message">
                  Your Parcelix account password has been successfully reset.
                  You can now use your new password to securely sign in to your
                  account.
                </p>

                <!-- Success Box -->

                <div class="success-box">
                  <p class="success-title">✓ Your password has been updated</p>

                  <p class="success-text">
                    Your old password is no longer valid. Please use your new
                    password the next time you sign in to Parcelix.
                  </p>
                </div>

                <!-- Login Button -->

                <div class="button-wrapper">
                  <a
                    href="<%= loginUrl %>"
                    class="button"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Sign in to Parcelix
                  </a>
                </div>

                <!-- Security Notice -->

                <div class="security-box">
                  <p class="security-title">🔒 Didn't reset your password?</p>

                  <p class="security-text">
                    If you did not make this change, please contact the Parcelix
                    support team immediately and secure your account.
                  </p>
                </div>

                <!-- Closing -->

                <p class="closing">
                  Thank you for using Parcelix. We're committed to keeping your
                  account secure.
                </p>

                <p class="closing">
                  Best regards,<br />
                  <strong>The Parcelix Team</strong>
                </p>
              </td>
            </tr>

            <!-- Footer -->

            <tr>
              <td class="footer">
                <p class="footer-text">
                  This is an automated security notification. Please do not
                  reply directly to this email.
                </p>

                <p class="copyright">
                  © <%= new Date().getFullYear() %> Parcelix. All rights
                  reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
